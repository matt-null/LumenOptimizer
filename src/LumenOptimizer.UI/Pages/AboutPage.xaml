<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumenOptimizer.UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="48,8,48,32" MaxWidth="780" HorizontalAlignment="Center" Spacing="14">

            <Button Content="&#x2190;  Back" Click="BackClick"/>

            <Image x:Name="StudioLogo" Height="64" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,4,0,0"
                   AutomationProperties.Name="Alright Dev"/>
            <StackPanel Spacing="2">
                <TextBlock x:Name="NameText" Visibility="Collapsed"/>
                <TextBlock x:Name="TaglineText" Opacity="0.75"/>
            </StackPanel>

            <TextBlock x:Name="AboutText" TextWrapping="Wrap"/>

            <StackPanel x:Name="ContactPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <HyperlinkButton x:Name="WebsiteLink" Visibility="Collapsed"/>
                <HyperlinkButton x:Name="EmailLink" Visibility="Collapsed"/>
                <HyperlinkButton x:Name="PhoneLink" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button x:Name="UpdateButton" Content="Check for updates" Click="UpdateClick"/>
                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" Opacity="0.75"/>
            </StackPanel>

            <TextBlock Text="What we do" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
            <ItemsControl ItemsSource="{x:Bind Services}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:StudioProject">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Specialties" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
            <ItemsControl ItemsSource="{x:Bind Specialties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:StudioProject">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Credits" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0"/>
            <ItemsControl ItemsSource="{x:Bind Credits}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:CreditItem">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind Role}" FontSize="12" Opacity="0.6"/>
                            <TextBlock Text="{x:Bind Name}" Visibility="{x:Bind PlainVisibility}" TextWrapping="Wrap"/>
                            <HyperlinkButton Content="{x:Bind Name}" NavigateUri="{x:Bind LinkUri}"
                                             Visibility="{x:Bind LinkVisibility}" Padding="0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="FooterText" Opacity="0.6" FontSize="12" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
