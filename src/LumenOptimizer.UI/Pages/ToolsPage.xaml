<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,8,32,24" Spacing="12" MaxWidth="820" HorizontalAlignment="Center">
            <StackPanel.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/></TransitionCollection></StackPanel.ChildrenTransitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Tools" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                           Text="Everything here shows you what will happen and asks before it changes anything."/>
            </StackPanel>

            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Cleaner" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Cleaner" FontWeight="SemiBold"/>
                    <TextBlock Text="Free disk space: temp files, update and browser caches, crash dumps, Recycle Bin, superseded update files and Windows.old. Scan first, then choose."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Devices" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Devices and old USB drives" FontWeight="SemiBold"/>
                    <TextBlock Text="Remove the records Windows keeps for hardware that is long gone: ghost devices, old USB sticks in Explorer, and drive letters still reserved for drives that are not attached."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Memory" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Memory" FontWeight="SemiBold"/>
                    <TextBlock Text="See what your RAM is really doing, and empty the standby list or trim working sets - with an honest note on when that helps and when it does not."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Startup" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Startup manager" FontWeight="SemiBold"/>
                    <TextBlock Text="See what starts with Windows and switch items off or back on. Nothing is deleted."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Uninstaller" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Uninstaller" FontWeight="SemiBold"/>
                    <TextBlock Text="Search installed programs and run their own uninstaller. Uninstalling cannot be undone."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Hosts" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Hosts file editor" FontWeight="SemiBold"/>
                    <TextBlock Text="Edit the hosts file with validation and a backup before every save. Optional telemetry block list."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Integrator" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Integrator (right-click menu)" FontWeight="SemiBold"/>
                    <TextBlock Text="Add handy right-click entries such as Open PowerShell here. Per-user and fully removable."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Network" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Network tools" FontWeight="SemiBold"/>
                    <TextBlock Text="Flush DNS, renew your IP, reset Winsock and TCP/IP, ping, trace route, and switch DNS provider with an undo."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Services" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Services" FontWeight="SemiBold"/>
                    <TextBlock Text="Change how background services start, with the original saved so you can restore it."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Tasks" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Scheduled tasks" FontWeight="SemiBold"/>
                    <TextBlock Text="See and disable the tasks Windows and programs run on a schedule."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Disks" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Optimize drives" FontWeight="SemiBold"/>
                    <TextBlock Text="Defragment hard disks and TRIM SSDs. USB and SD flash is skipped on purpose."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="UsbClean" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="USB / SD drive cleaner" FontWeight="SemiBold"/>
                    <TextBlock Text="Remove junk files from removable drives. Also offered when you plug one in."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="ForceDelete" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Force delete" FontWeight="SemiBold"/>
                    <TextBlock Text="Remove files and folders that will not delete: ownership, SYSTEM, delete at restart."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Tag="Accounts" Click="ToolClick">
                <StackPanel Spacing="2">
                    <TextBlock Text="Local accounts" FontWeight="SemiBold"/>
                    <TextBlock Text="Reset a forgotten local password, unlock or enable accounts, manage administrators."
                               TextWrapping="Wrap" Opacity="0.75"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</Page>
