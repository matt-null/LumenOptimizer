<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LumenOptimizer.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LumenOptimizer.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="ConsoleRow" Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: content extends into it, Mica shows through, caption buttons stay native. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="18" Height="18"/>
                <TextBlock Text="Lumen Optimizer" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1"/>

        <local:ConsolePanel x:Name="ConsoleDock" Grid.Row="2" Height="250" Visibility="Collapsed"/>

        <Grid Grid.Row="3" Padding="24,10,24,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock FontSize="12" Opacity="0.65" VerticalAlignment="Center"
                           Text="Built with &#x2764;&#xFE0F; by"/>
                <HyperlinkButton x:Name="CreditLink" Content="Alright Dev" Padding="0" FontSize="12"
                                 Click="CreditClick"/>
            </StackPanel>
            <ToggleButton x:Name="ConsoleToggle" Grid.Column="1" Click="ConsoleToggleClick" ToolTipService.ToolTip="Show or hide the live console">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE756;" FontSize="14"/>
                    <TextBlock Text="Console"/>
                </StackPanel>
            </ToggleButton>
            <TextBlock x:Name="StepText" Grid.Column="2" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,0"/>
            <Button x:Name="BackButton" Grid.Column="3" Content="Back" MinWidth="90" Click="BackClick"/>
            <Button x:Name="NextButton" Grid.Column="4" Content="Next" MinWidth="120"
                    Style="{StaticResource AccentButtonStyle}" Click="NextClick"/>
        </Grid>
    </Grid>
</Window>
