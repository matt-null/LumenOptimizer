<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumenOptimizer.UI.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,8,32,24" Spacing="12" MaxWidth="940" HorizontalAlignment="Center">

            <StackPanel Spacing="2">
                <TextBlock Text="Devices and old USB drives" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                           Text="Windows keeps a record of every device that has ever been plugged in. Those records are what make old USB sticks, printers and drives keep showing up long after you got rid of them. Everything here is previewed before anything is removed."/>
            </StackPanel>

            <InfoBar x:Name="ResultBar" IsOpen="False"/>

            <!-- ===================================================== ghosts -->
            <TextBlock Text="Devices that are not plugged in" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="These are the hidden ('ghost') entries in Device Manager. Removing one only deletes the stored record; plug the device back in and Windows sets it up again. There is no undo, because there is nothing to put back."/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanDevicesButton" Content="Scan again" Click="ScanDevicesClick"/>
                <CheckBox x:Name="UsbOnlyBox" Content="USB, drives and other plug-in hardware only" IsChecked="True"
                          Checked="FilterChanged" Unchecked="FilterChanged" VerticalAlignment="Center"/>
                <Button Content="Select all shown" Click="SelectAllDevicesClick"/>
                <Button Content="Select none" Click="SelectNoDevicesClick"/>
                <ProgressRing x:Name="DeviceRing" Width="20" Height="20" IsActive="False"/>
            </StackPanel>

            <TextBlock x:Name="DeviceCountText" Opacity="0.7" FontSize="12"/>

            <ListView ItemsSource="{x:Bind Ghosts}" SelectionMode="None" MaxHeight="340">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GhostDeviceViewModel">
                        <Grid Padding="4,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Top"
                                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind InstanceId}" FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}"
                                           FontSize="12" Foreground="DarkOrange" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind Class}" Opacity="0.7" FontSize="12" VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RemoveDevicesButton" Content="Remove selected records…"
                        Style="{StaticResource AccentButtonStyle}" Click="RemoveDevicesClick"/>
                <Button Content="Open Device Manager with hidden devices" Click="OpenDeviceManagerClick"/>
            </StackPanel>

            <!-- ============================================== stale records -->
            <TextBlock Text="Leftover drive records" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Saved names and drive letters for drives that are not attached. These are what put old USB sticks in Explorer's sidebar and AutoPlay lists, and what keeps a drive letter reserved so a new drive gets a different one. Windows recreates whatever it still needs, and these removals are backed up to a file first."/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ScanRecordsButton" Content="Scan again" Click="ScanRecordsClick"/>
                <Button Content="Select all" Click="SelectAllRecordsClick"/>
                <Button Content="Select none" Click="SelectNoRecordsClick"/>
                <ProgressRing x:Name="RecordRing" Width="20" Height="20" IsActive="False"/>
            </StackPanel>

            <TextBlock x:Name="RecordCountText" Opacity="0.7" FontSize="12"/>

            <ListView ItemsSource="{x:Bind Records}" SelectionMode="None" MaxHeight="300">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StaleRecordViewModel">
                        <Grid Padding="4,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Top"
                                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Where}" FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RemoveRecordsButton" Content="Remove selected records…"
                        Style="{StaticResource AccentButtonStyle}" Click="RemoveRecordsClick"/>
                <ComboBox x:Name="BackupBox" PlaceholderText="Backups" MinWidth="220"/>
                <Button Content="Restore backup" Click="RestoreBackupClick"/>
            </StackPanel>

            <!-- ================================================ usb history -->
            <TextBlock Text="USB drive history" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Every USB storage device this PC has ever had plugged in, as recorded in the driver database. This list is read-only: clearing it needs rights that only Windows itself holds, and Lumen Optimizer will not take them."/>
            <TextBlock x:Name="HistoryText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
