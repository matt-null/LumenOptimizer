<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.UninstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumenOptimizer.UI.ViewModels">

    <Grid Padding="32,8,32,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Uninstaller" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Installed desktop programs. Uninstalling runs the program's own uninstaller and cannot be undone. Microsoft Store apps are handled on the Debloat page."/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search installed programs" QueryIcon="Find"
                            TextChanged="SearchChanged"/>
            <CheckBox x:Name="QuietBox" Grid.Column="1" Content="Silent uninstall when available" VerticalAlignment="Center"/>
            <Button x:Name="UninstallButton" Grid.Column="2" Content="Uninstall…" Style="{StaticResource AccentButtonStyle}" Click="UninstallClick"/>
        </Grid>

        <InfoBar x:Name="ResultBar" Grid.Row="2" IsOpen="False"/>

        <ListView x:Name="ProgramList" Grid.Row="3" ItemsSource="{x:Bind Items}" SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProgramViewModel">
                    <StackPanel Padding="4,6" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Details}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
