<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.TweaksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumenOptimizer.UI.ViewModels">

    <Grid Padding="32,8,32,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="SubtitleText" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>

        <InfoBar x:Name="AdvancedBar" Grid.Row="1" Severity="Error" IsOpen="True" IsClosable="False" Visibility="Collapsed"
                 Title="These can weaken security or break features"
                 Message="Nothing here is ever preselected. Read each warning before ticking a tweak; you will be asked to confirm again on the review page."/>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Select what fits this PC" Click="SelectFitsClick"/>
            <Button Grid.Column="1" Content="Select none" Click="SelectNoneClick"/>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search" QueryIcon="Find" TextChanged="SearchChanged"/>
            <ComboBox x:Name="FilterBox" Grid.Column="3" SelectedIndex="0" SelectionChanged="FilterChanged" MinWidth="150">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Fits this PC"/>
                <ComboBoxItem Content="Not applied"/>
                <ComboBoxItem Content="Already applied"/>
                <ComboBoxItem Content="Needs restart"/>
                <ComboBoxItem Content="Safe"/>
                <ComboBoxItem Content="Moderate"/>
                <ComboBoxItem Content="Aggressive"/>
            </ComboBox>
            <TextBlock x:Name="CountText" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75"/>
        </Grid>

        <ListView Grid.Row="3" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TweakItemViewModel">
                    <Grid ColumnSpacing="12" Padding="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Top"
                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  IsEnabled="{x:Bind CanSelect, Mode=OneWay}"/>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75"/>
                            <TextBlock Text="{x:Bind FitText}" Visibility="{x:Bind FitVisibility}"
                                       TextWrapping="Wrap" Foreground="SeaGreen"/>
                            <TextBlock Text="{x:Bind Warning}" Visibility="{x:Bind WarningVisibility}"
                                       TextWrapping="Wrap" Foreground="{x:Bind RiskBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Width="150" HorizontalAlignment="Right" Spacing="2">
                            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{x:Bind RiskText}" Foreground="{x:Bind RiskBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{x:Bind Notes}" Opacity="0.6" FontSize="12"
                                       TextWrapping="Wrap" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
