<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.UndoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumenOptimizer.UI.ViewModels">

    <Grid Padding="32,8,32,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Undo previous changes" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Tweaks applied by Lumen Optimizer that can be put back to their original value. Removed apps are not listed: reinstall them from the Microsoft Store."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Select all" Click="SelectAllClick"/>
            <Button Content="Select none" Click="SelectNoneClick"/>
            <Button x:Name="RevertButton" Content="Undo selected" Style="{StaticResource AccentButtonStyle}" Click="RevertClick"/>
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TweakItemViewModel">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Top"
                                  IsChecked="{x:Bind IsUndoSelected, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Top"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8">
            <ProgressBar x:Name="Progress" Visibility="Collapsed"/>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True"/>
        </StackPanel>
    </Grid>
</Page>
