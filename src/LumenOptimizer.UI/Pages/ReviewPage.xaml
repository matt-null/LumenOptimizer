<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.ReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumenOptimizer.UI.ViewModels">

    <Grid Padding="32,8,32,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Review your changes" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Opacity="0.75"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="NoUndoBar" Severity="Warning" IsOpen="False" IsClosable="False"/>
            <InfoBar x:Name="RiskBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="Risky changes selected"
                     Message="One or more selected tweaks can weaken security or break features. Read their warnings below."/>
        </StackPanel>

        <ListView Grid.Row="2" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TweakItemViewModel">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Warning}" Visibility="{x:Bind WarningVisibility}"
                                       TextWrapping="Wrap" Foreground="{x:Bind RiskBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Width="150" HorizontalAlignment="Right" Spacing="2">
                            <TextBlock Text="{x:Bind RiskText}" Foreground="{x:Bind RiskBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{x:Bind Notes}" Opacity="0.6" FontSize="12"
                                       TextWrapping="Wrap" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="6">
            <Button Content="Save this selection to a file…" Click="SaveSelectionClick"/>
            <CheckBox x:Name="RestorePointBox" Content="Create a System Restore point before applying (recommended)"
                      Checked="OptionsChanged" Unchecked="OptionsChanged"/>
            <CheckBox x:Name="AckBox" Visibility="Collapsed"
                      Content="I understand the risks of the risky tweaks I selected"
                      Checked="OptionsChanged" Unchecked="OptionsChanged"/>
        </StackPanel>
    </Grid>
</Page>
