<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LumenOptimizer.UI.Pages.CleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LumenOptimizer.UI.ViewModels">

    <Grid Padding="32,8,32,8" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Cleaner" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="Removes temporary files and caches. Your documents, downloads, desktop and saved passwords are never touched. Deleted files do not go to the Recycle Bin. The items that are unticked by default are the ones with a real trade-off, so read their note before ticking them."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RescanButton" Content="Scan again" Click="RescanClick"/>
            <Button x:Name="CleanButton" Content="Clean selected" Style="{StaticResource AccentButtonStyle}" Click="CleanClick"/>
            <ProgressRing x:Name="Ring" Width="20" Height="20" IsActive="False"/>
            <TextBlock x:Name="TotalText" VerticalAlignment="Center" Opacity="0.75"/>
        </StackPanel>

        <InfoBar x:Name="ResultBar" Grid.Row="2" IsOpen="False"/>

        <ListView Grid.Row="3" ItemsSource="{x:Bind Items}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanItemViewModel">
                    <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Top"
                                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Top" Opacity="0.8"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
